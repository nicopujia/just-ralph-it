# Optional in DEV mode (defaults to "dev"), required in PROD
SECRET_KEY=your-32-char-hex-secret-key-here

# If true, users won't be able to access or create projects
MAINTENANCE_MODE=false

# Determines which variables from below will be used. Can be DEV or PROD
MODE=DEV

DEV_BASE_URL=http://localhost:8000
DEV_GITHUB_CLIENT_SECRET=
DEV_GITHUB_CLIENT_ID=
DEV_STRIPE_SECRET_KEY=sk_test_...

PROD_BASE_URL=https://justralph.it
PROD_GITHUB_CLIENT_SECRET=
PROD_GITHUB_CLIENT_ID=
PROD_STRIPE_SECRET_KEY=sk_live_...
