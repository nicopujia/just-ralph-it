# Required for live JRI CLI runs with the default OpenRouter provider.
OPENROUTER_API_KEY=

# Optional. Required only when the explorer uses the web_search tool.
BRAVE_SEARCH_API_KEY=

# Optional. Model provider supported by Pydantic AI through JRI's provider layer.
JRI_MODEL_PROVIDER=openrouter

# Optional. Named model preset for the selected provider.
JRI_MODEL_PRESET=cheap

# Optional. Override the interviewer model ID for the selected provider.
JRI_INTERVIEWER_MODEL_ID=deepseek/deepseek-chat

# Optional. Override the vision-capable explorer model ID for the selected provider.
JRI_EXPLORER_MODEL_ID=qwen/qwen2.5-vl-32b-instruct

# Development/testing only. Leave unset for real model runs.
# JRI_INTERVIEWER_FACTORY=tests.doubles.interviewers:create_scripted_interviewer
