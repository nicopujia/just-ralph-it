# Required
SECRET_KEY=your-32-char-hex-secret-key-here
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# Staging mode — uses test Stripe credentials when true
STAGING=true

# Stripe — test keys (used when STAGING=true)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — prod keys (used when STAGING=false)
PROD_STRIPE_SECRET_KEY=sk_live_...
PROD_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional
BASE_URL=https://justralph.it
