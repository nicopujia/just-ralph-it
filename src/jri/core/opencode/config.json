{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "read": "allow"
  },
  "agent": {
    "interrogator": {
      "model": "vercel/xai/grok-4.20-reasoning",
      "temperature": 0.7,
      "description": "Interrogates user and manages tasks.",
      "mode": "primary",
      // Yellow, like Ralph Wiggum
      "color": "#ffd500",
      "permission": {
        "*": "deny",
        "edit": {
          "*": "deny",
          "README.md": "allow"
        },
        "read": {
          "*": "deny",
          "README.md": "allow"
        },
        "question": "allow",
        "*-task*": "allow",
        "task": {
          "*": "deny",
          "interrogator-validator": "allow",
          "explore": "allow"
        }
      }
    },
    "interrogator-validator": {
      "model": "vercel/deepseek/deepseek-r1",
      "temperature": 0,
      "reasoningEffort": "high",
      "description": "Checks if tasks are free of ambiguities",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "check-draft-promotion": "allow",
        "read-tasks": "allow"
      }
    },
    "ralph": {
      "model": "vercel/moonshotai/kimi-k2.5",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "description": "Solves a single task autonomously.",
      "mode": "primary",
      "permission": {
        "*": "allow",
        "interrogator-validator": "deny",
        "question": "deny",
        "list-tasks": "deny",
        "read-tasks": "deny",
        "check-draft-promotion": "deny",
        "promote-tasks": "deny",
        "task": {
          "*": "allow",
          "interrogator-validator": "deny"
        }
      }
    },
    "ralph-validator": {
      "model": "vercel/zai/glm-5",
      "temperature": 0,
      "reasoningEffort": "high",
      "description": "Checks if things work and are clean",
      "mode": "subagent",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "ralph-result": "deny",
        "*-task*": "deny",
        "task": {
          "*-validator": "deny"
        }
      }
    },
    "explore": {
      "model": "vercel/alibaba/qwen3.5-flash",
      "temperature": 0.2,
      "permission": {
        "ralph-result": "deny",
        "*-task*": "deny",
        "task": {
          "*-validator": "deny"
        }
      }
    },
    "general": {
      "model": "vercel/deepseek/deepseek-v3.2",
      "temperature": 0.5,
      "reasoningEffort": "medium",
      "permission": {
        "ralph-result": "deny",
        "*-task*": "deny",
        "task": {
          "*-validator": "deny"
        }
      }
    }
  },
  "provider": {
    "default": {
      "chat": {
        "model": "vercel/xai/grok-4.20-reasoning",
        "validator_model": "vercel/deepseek/deepseek-r1",
        "explore_model": "vercel/alibaba/qwen3.5-flash"
      },
      "start": {
        "model": "vercel/moonshotai/kimi-k2.5",
        "validator_model": "vercel/zai/glm-5",
        "general_model": "vercel/deepseek/deepseek-v3.2",
        "explore_model": "vercel/alibaba/qwen3.5-flash"
      }
    },
    "openai": {
      "chat": {
        "model": "openai/gpt-5.4",
        "validator_model": "openai/gpt-5.4",
        "explore_model": "openai/gpt-5.4-mini"
      },
      "start": {
        "model": "openai/gpt-5.4-pro",
        "validator_model": "openai/gpt-5.4",
        "general_model": "openai/gpt-5-codex",
        "explore_model": "openai/gpt-5.4-mini"
      }
    }
  },
  "mcp": {
    "grep-mcp": {
      "type": "local",
      "command": ["uvx", "grep-mcp"],
      "enabled": true
    }
  }
}
