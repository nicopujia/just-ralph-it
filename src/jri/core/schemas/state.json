{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "attempt": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "task_slug": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "started_at": {
          "type": "integer"
        },
        "finished_at": {
          "type": "integer"
        },
        "log_path": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "completed",
            "incompleted",
            "incomplete",
            "needs_human",
            "failed",
            "interrupted",
            "timeout"
          ]
        },
        "result_payload": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "enum": ["completed", "incompleted", "needs_human"]
            },
            "summary": {
              "type": "string"
            },
            "learnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocker": {
              "type": "string"
            },
            "human_task": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "priority": {
                  "type": "integer"
                }
              }
            }
          },
          "required": ["result"]
        }
      },
      "required": [
        "number",
        "task_slug",
        "branch",
        "started_at"
      ]
    },
    "promotion": {
      "type": "object",
      "properties": {
        "confirmed_at": {
          "type": "integer"
        },
        "task_slugs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "content_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "target_status": {
          "type": "string",
          "enum": ["todo"]
        }
      },
      "required": [
        "confirmed_at",
        "task_slugs",
        "content_digests",
        "target_status"
      ]
    }
  },
  "type": "object",
  "properties": {
    "started_at": {
      "type": "integer",
      "description": "Unix timestamp in seconds indicating the last time a task was started."
    },
    "finished_at": {
      "type": "integer",
      "description": "Unix timestamp in seconds indicating the last time a task was finished."
    },
    "session": {
      "type": "string",
      "description": "Pi session ID pointing to the current project's interrogation."
    },
    "branch": {
      "type": "string",
      "description": "Default branch name recorded at init time."
    },
    "current_task": {
      "type": "string",
      "description": "The slug of the currently running task, if any."
    },
    "process": {
      "type": "object",
      "description": "Ephemeral runtime information for a currently running Ralph loop.",
      "properties": {
        "loop_pid": {
          "type": "integer",
          "description": "PID of the active loop process."
        },
        "child_pid": {
          "type": ["integer", "null"],
          "description": "PID of the currently running Pi subprocess, if any."
        },
        "log_path": {
          "type": ["string", "null"],
          "description": "Path to the current Ralph log file."
        },
        "detached": {
          "type": "boolean",
          "description": "Whether the loop was launched in detached mode."
        }
      }
    },
    "active_attempt": {
      "$ref": "#/$defs/attempt",
      "description": "The currently active task attempt, if a run is in progress or final bookkeeping is pending."
    },
    "attempts": {
      "type": "array",
      "description": "Execution-attempt journal for Ralph task runs.",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "promotion": {
      "$ref": "#/$defs/promotion",
      "description": "The latest draft-to-todo promotion."
    }
  }
}
