{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "read": "allow"
  },
  "agent": {
    "interrogator": {
      "model": "openrouter/qwen/qwen3.6-plus",
      "temperature": 0.7,
      "description": "Interrogates user and manages tasks.",
      "mode": "primary",
      "color": "#ffd500", // yellow, like Ralph Wiggum
      "permission": {
        "question": "allow",
        "write": {
          "*": "deny",
          "README.md": "allow"
        },
        "edit": {
          "*": "deny",
          "README.md": "allow"
        },
        "promote-tasks": "deny",
        "ralph-*": "deny",
        "task": {
          "*": "deny",
          "interrogator-*": "allow",
          "explore": "allow"
        }
      }
    },
    "interrogator-validator": {
      "model": "openrouter/deepseek/deepseek-r1",
      "temperature": 0,
      "reasoningEffort": "high",
      "description": "Checks if tasks are free of ambiguities",
      "mode": "subagent",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "ralph-*": "deny",
        "interrogator-*": "deny",
        "upsert-tasks": "deny",
        "rename-tasks": "deny",
        "delete-tasks": "deny",
        "promote-tasks": "allow",
        "task": {
          "ralph-*": "deny",
          "interrogator-*": "deny"
        }
      }
    },
    "ralph": {
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "description": "Solves a single JRI task autonomously.",
      "mode": "primary",
      "permission": {
        "*": "allow",
        "interrogator-*": "deny",
        "task": {
          "*": "allow",
          "interrogator-*": "deny"
        }
      }
    },
    "ralph-validator": {
      "model": "openrouter/z-ai/glm-5",
      "temperature": 0,
      "reasoningEffort": "high",
      "description": "Checks if things work and are clean",
      "mode": "subagent",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "bash": "deny",
        "ralph-*": "deny",
        "interrogator-*": "deny",
        "task": {
          "ralph-*": "deny",
          "interrogator-*": "deny"
        }
      }
    },
    "explore": {
      "model": "openrouter/qwen/qwen3.5-flash-02-23",
      "temperature": 0.2
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v3.2",
      "temperature": 0.5,
      "reasoningEffort": "medium",
      "permission": {
        "ralph-*": "deny",
        "interrogator-*": "deny",
        "task": {
          "ralph-*": "deny",
          "interrogator-*": "deny"
        }
      }
    }
  },
  "mcp": {
    "grep-mcp": {
      "type": "local",
      "command": ["uvx", "grep-mcp"],
      "enabled": true
    }
  }
}
